# Backend environment variables — CommunityIncidentReporting.Api
#
# ASP.NET Core reads configuration from environment variables using the "__" (double
# underscore) hierarchy separator (e.g. ConnectionStrings__DefaultConnection maps to
# configuration key ConnectionStrings:DefaultConnection). In local development you can
# either export these directly, use `dotnet user-secrets`, or place a `.env` copy of this
# file at backend/src/CommunityIncidentReporting.Api/.env — it is loaded automatically in
# the Development environment only (see Program.cs) and is git-ignored.
#
# NEVER commit a real .env file or real Supabase credentials.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- Supabase PostgreSQL connection ---
# Get this from Supabase Project Settings -> Database -> Connection string (URI or .NET style).
#
# Direct connection (IPv6-only on the free tier; needs the paid IPv4 add-on otherwise):
# Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
#
# Session pooler (what most projects get by default now — works fine for a long-lived
# server process like this API; note the username includes the project ref):
# Host=<region>.pooler.supabase.com;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=

# --- JWT authentication ---
# Symmetric signing key for access/refresh tokens. Generate a long random value, e.g.:
#   openssl rand -base64 64
Jwt__Secret=
Jwt__Issuer=UComplain
Jwt__Audience=UComplain.AdminPortal
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# --- CORS ---
Cors__AllowedOrigins__0=http://localhost:3000

# --- Development seed data ---
# Password used only when seeding the initial SuperAdmin account in Development.
# Never used, read, or seeded outside the Development environment.
SeedData__SuperAdminPassword=

# --- WhatsApp Cloud API webhook ---
# See docs/whatsapp-integration-plan.md for the full contract. Everything here is
# optional at startup — an unset AppSecret just means every inbound webhook call
# fails signature verification (fails closed), and an unset AccessToken/PhoneNumberId
# just means inbound reports still get created but no outbound reply gets sent.
#
# Meta App -> App Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256 on
# every inbound call — this is the only thing authenticating this endpoint, since
# Meta can't present an admin JWT.
WhatsApp__AppSecret=
# Any string you choose — re-enter the same value in Meta's webhook setup form
# (App -> WhatsApp -> Configuration -> Webhook -> Verify token) when you subscribe.
WhatsApp__VerifyToken=
# Meta App -> WhatsApp -> API Setup -> Temporary/Permanent access token. Needed only
# to send the outbound acknowledgment reply.
WhatsApp__AccessToken=
# Meta App -> WhatsApp -> API Setup -> Phone number ID.
WhatsApp__PhoneNumberId=
WhatsApp__ApiVersion=v21.0
# HMAC key used to hash inbound WhatsApp numbers before they're ever stored — a plain
# unsalted hash would be reversible by brute force given how small the phone-number
# keyspace is. Generate once (e.g. `openssl rand -base64 32`) and never rotate it —
# rotating would silently orphan every existing reporter's lookup.
WhatsApp__NumberHashKey=

# --- Resend transactional email (mobile reporter OTP / password reset / welcome) ---
# Render's free tier has no outbound SMTP, so email is sent via Resend's HTTP API
# instead. These four are read as flat keys (not nested under a nested "Resend:" config
# section) since that's how Render's dashboard and this project's deployment docs name
# them. Get an API key from https://resend.com/api-keys; FromEmail must be on a domain
# verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=UComplain
# Public base URL of this API (used in email content, e.g. links back to the app).
APP_BASE_URL=http://localhost:5000

# --- Mobile reporter OTP (email verification / password reset) ---
# HMAC key used to hash OTP codes before they're stored — never the raw code. Generate
# once (e.g. `openssl rand -base64 32`); unlike WhatsApp__NumberHashKey this CAN be
# rotated safely (it only invalidates OTPs currently in flight, not stored accounts).
Otp__HashKey=
Otp__ExpiryMinutes=10
Otp__MaxAttempts=5
Otp__ResendCooldownSeconds=45

# --- Mobile reporter JWT (separate signing key/audience from the admin scheme above,
# so a leaked admin secret can never be used to forge a reporter session or vice versa) ---
Jwt__ReporterSecret=
Jwt__ReporterIssuer=UComplain
Jwt__ReporterAudience=UComplain.MobileApp
Jwt__ReporterAccessTokenMinutes=15
Jwt__ReporterRefreshTokenDays=30
# Refresh token lifetime when a mobile login's rememberMe=false instead (a short session).
Jwt__ReporterShortSessionHours=12

# --- Supabase Storage (private bucket for incident media attachments) ---
# Project Settings -> API. The service role key is backend-only — it must never be
# embedded in the mobile app, logged, or returned from any endpoint. See
# backend/supabase-storage-setup.sql for how to create the bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=incident-media

# --- Mobile media upload limits (all optional — defaults shown) ---
# MediaUpload__MaxImages=5
# MediaUpload__MaxVideos=2
# MediaUpload__MaxAudioFiles=1
# MediaUpload__MaxDocuments=3
# MediaUpload__MaxImageSizeBytes=10485760
# MediaUpload__MaxVideoSizeBytes=104857600
# MediaUpload__MaxAudioSizeBytes=20971520
# MediaUpload__MaxDocumentSizeBytes=10485760
# MediaUpload__SignedUrlExpirySeconds=300

# --- Clarification loop (all optional — defaults shown) ---
# How long a reporter has to respond to an admin's clarification request before
# ClarificationAutoCloseJob closes the report automatically.
# Clarification__DeadlineHours=48
# Clarification__AutoCloseSweepIntervalMinutes=30

# --- Compliance: data export / account deletion / retention purge (all optional — defaults shown) ---
# How long a reporter has to cancel their own account-deletion request before
# AccountDeletionJob executes it.
# Compliance__AccountDeletionGracePeriodDays=14
# Compliance__DataExportSweepIntervalMinutes=5
# Compliance__AccountDeletionSweepIntervalMinutes=60
# Compliance__RetentionPurgeSweepIntervalHours=24
# How long a data-export download link stays valid once issued.
# Compliance__DataExportSignedUrlExpirySeconds=300
