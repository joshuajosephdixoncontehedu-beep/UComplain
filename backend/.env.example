# Backend environment variables — CommunityIncidentReporting.Api
#
# ASP.NET Core reads configuration from environment variables using the "__" (double
# underscore) hierarchy separator (e.g. ConnectionStrings__DefaultConnection maps to
# configuration key ConnectionStrings:DefaultConnection). In local development you can
# either export these directly, use `dotnet user-secrets`, or place a `.env` copy of this
# file at backend/src/CommunityIncidentReporting.Api/.env — it is loaded automatically in
# the Development environment only (see Program.cs) and is git-ignored.
#
# NEVER commit a real .env file or real Supabase credentials.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- Supabase PostgreSQL connection ---
# Get this from Supabase Project Settings -> Database -> Connection string (URI or .NET style).
#
# Direct connection (IPv6-only on the free tier; needs the paid IPv4 add-on otherwise):
# Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
#
# Session pooler (what most projects get by default now — works fine for a long-lived
# server process like this API; note the username includes the project ref):
# Host=<region>.pooler.supabase.com;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=

# --- JWT authentication ---
# Symmetric signing key for access/refresh tokens. Generate a long random value, e.g.:
#   openssl rand -base64 64
Jwt__Secret=
Jwt__Issuer=UComplain
Jwt__Audience=UComplain.AdminPortal
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# --- CORS ---
Cors__AllowedOrigins__0=http://localhost:3000

# --- Development seed data ---
# Password used only when seeding the initial SuperAdmin account in Development.
# Never used, read, or seeded outside the Development environment.
SeedData__SuperAdminPassword=
