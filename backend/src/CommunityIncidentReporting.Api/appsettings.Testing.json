{
  "_comment": "Used only by integration tests (ASPNETCORE_ENVIRONMENT=Testing via WebApplicationFactory). Loaded automatically by ASP.NET Core's environment-specific configuration before Program.cs runs, so Program.cs's fail-fast config checks see these values even though the DbContext itself is swapped for EF Core InMemory by CustomWebApplicationFactory. Not a real secret and never used outside the test host.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=test_unused;Username=test;Password=test"
  },
  "Jwt": {
    "Secret": "integration-test-signing-secret-at-least-32-characters-long",
    "Issuer": "UComplain.IntegrationTests",
    "Audience": "UComplain.IntegrationTests.AdminPortal",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ReporterSecret": "integration-test-reporter-signing-secret-at-least-32-chars",
    "ReporterIssuer": "UComplain.IntegrationTests",
    "ReporterAudience": "UComplain.IntegrationTests.MobileApp",
    "ReporterAccessTokenMinutes": 15,
    "ReporterRefreshTokenDays": 30,
    "ReporterShortSessionHours": 1
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "WhatsApp": {
    "AppSecret": "integration-test-app-secret",
    "VerifyToken": "integration-test-verify-token",
    "NumberHashKey": "integration-test-number-hash-key"
  },
  "Otp": {
    "HashKey": "integration-test-otp-hash-key",
    "ExpiryMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "SUPABASE_URL": "https://integration-test.supabase.co",
  "SUPABASE_SERVICE_ROLE_KEY": "integration-test-service-role-key",
  "SUPABASE_STORAGE_BUCKET": "incident-media-test",
  "MediaUpload": {
    "MaxImages": 2,
    "MaxVideos": 2,
    "MaxAudioFiles": 1,
    "MaxDocuments": 1,
    "MaxImageSizeBytes": 1024,
    "MaxVideoSizeBytes": 1024,
    "MaxAudioSizeBytes": 1024,
    "MaxDocumentSizeBytes": 1024,
    "SignedUrlExpirySeconds": 300
  }
}
