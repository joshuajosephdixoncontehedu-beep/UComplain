# Mobile environment variables — Reporter App (Expo)
#
# Expo inlines any EXPO_PUBLIC_* var into the client bundle at build time.
# Copy this file to .env.local for local development and never commit real values.

# Base URL of the CommunityIncidentReporting.Api backend's /api/mobile/... routes.
# See docs/mobile-api-contract.md and docs/mobile-client-backend-extension.md.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5058
